{
  "name": "keel-landing",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gray-matter": "^4.0.3",
    "next": "14.2.35",
    "next-mdx-remote": "^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run content:check && next build",
    "start": "next start",
    "lint": "next lint",
